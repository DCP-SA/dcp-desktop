{
  "$schema": "https://raw.githubusercontent.com/nickel-org/tauri/main/.schema/config.schema.json",
  "productName": "DCP Provider",
  "version": "0.2.8",
  "identifier": "sa.dcp.provider",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DCP Agent",
        "width": 320,
        "height": 480,
        "minWidth": 300,
        "minHeight": 200,
        "center": false,
        "x": 800,
        "y": 30,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-online.png",
      "iconAsTemplate": false
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.dcp.sa https://*.dcp.sa http://localhost:8642; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.dcp.sa/api/providers/updates/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3OENBRURBNDVCQjc5RjQKUldUMGVidEYycTZNdCtwL3FGdHpjUTU5T3IrMVlIN1Q2bENxVmkvb2xPeUd4ZjhuSnRkOFNXTysK"
    }
  }
}
