{
  "$schema": "https://raw.githubusercontent.com/nickel-org/tauri/main/.schema/config.schema.json",
  "productName": "DCP Provider",
  "version": "0.2.8",
  "identifier": "sa.dcp.provider",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DCP — GPU Compute Provider",
        "width": 560,
        "height": 640,
        "minWidth": 480,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.dcp.sa; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": [
          "wireguard-tools",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ],
        "files": {
          "/usr/share/polkit-1/actions/sa.dcp.provider.policy": "../policy/sa.dcp.provider.policy",
          "/usr/lib/systemd/user/dcp-provider.service": "tauri/linux/systemd/dcp-provider.service"
        },
        "postInstallScript": "tauri/linux/postinst.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.dcp.sa/api/providers/updates/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3OENBRURBNDVCQjc5RjQKUldUMGVidEYycTZNdCtwL3FGdHpjUTU5T3IrMVlIN1Q2bENxVmkvb2xPeUd4ZjhuSnRkOFNXTysK"
    }
  }
}
